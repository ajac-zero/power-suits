# The exact JDK the Release workflow builds with (Eclipse Temurin, Linux x64), pinned so every build of a tag uses the
# same compiler: a different Java 25 update could compile a byte differently and break "rebuild it, compare the
# checksum". The checksum below is Adoptium's, checked before the JDK is used. To move to a newer one, take the values
# from https://api.adoptium.net/v3/assets/release_name/eclipse/<release>?os=linux&architecture=x64&image_type=jdk
# (to rebuild locally, use the same version: Homebrew's openjdk@25 is 25.0.4.1 too).
JDK_RELEASE=jdk-25.0.4.1+1
JDK_URL=https://github.com/adoptium/temurin25-binaries/releases/download/jdk-25.0.4.1%2B1/OpenJDK25U-jdk_x64_linux_hotspot_25.0.4.1_1.tar.gz
JDK_SHA256=dbb698396d478e7fa2b1e50f4103324b2a99b90569ee27c33f2261f9215cf41e
